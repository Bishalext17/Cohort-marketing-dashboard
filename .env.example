# =============================================================================
# BAMBINOS COHORT MARKETING DASHBOARD - ENVIRONMENT CONFIGURATION
# =============================================================================

# Database Configuration (MariaDB / MySQL Production Instance)
DB_HOST=localhost
DB_PORT=3306
DB_USER=growth_reader
DB_PASSWORD=your_secure_db_password
DB_NAME=production
DB_READ_ONLY=true

# Direct Meta Marketing Graph API Configuration (v20.0)
META_ACCESS_TOKEN=EAAG...your_long_lived_system_user_token...
META_AD_ACCOUNT_IDS=act_123456789,act_987654321
META_API_VERSION=v20.0

# API Security & JWT Authentication
JWT_SECRET_KEY=bambinos-cohort-secret-jwt-key-2026-production-secure-random
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME="Growth Executive"
ADMIN_ROLE="Admin"

# Performance & Caching Controls
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_PREWARM_ENABLED=true
CACHE_PREWARM_INTERVAL_MINUTES=30
MOCK_DATA_FALLBACK=true
